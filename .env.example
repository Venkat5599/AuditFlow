# Engine = OpenCode Zen gateway with the FREE DeepSeek model.
# Key from `opencode auth` (provider opencode-go), passed as a Bearer token.
OPENCODE_API_KEY=
AUDITFLOW_MODEL=deepseek-v4-flash-free
# OPENCODE_BASE=https://opencode.ai/zen/v1   # override only if needed
# Optional DeepSeek-platform fallback (paid):
DEEPSEEK_API_KEY=
# GitHub token for CLI mode (repo scope). Web app uses OAuth instead.
GITHUB_TOKEN=
# Root of the skills hub (defaults to cwd). Skill SKILL.md files are read from here.
AUDITFLOW_HUB=..

# --- GitHub OAuth (web app) ---
# Create at https://github.com/settings/developers (callback = GITHUB_CALLBACK_URL).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUDITFLOW_STATE_SECRET=change-me-to-a-random-string

# --- Mantle on-chain attestation (optional) ---
# Deploy contracts/src/AuditRegistry.sol, then set its address here.
AUDITFLOW_REGISTRY=
AUDITFLOW_PRIVATE_KEY=
AUDITFLOW_CHAIN=sepolia          # "mainnet" (5000) or "sepolia" (5003)
MANTLESCAN_API_KEY=
